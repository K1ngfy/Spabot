{
  "manifest_version": 3,
  "name": "Spabot",
  "version": "1.1",
  "description": "An intelligent search assistant for Splunk SPL and ELK Kibana ES|QL that provides saved searches, quick references (indexes/macros/REST for Splunk, ES|QL syntax and Data Views for ELK), and a fun interactive bot interface to boost your productivity.",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*/app/*/search*",
        "*://localhost/*/app/*/search*",
        "*://*/*/app/discover*",
        "*://localhost/*/app/discover*"
      ],
      "js": ["default_saved_searches.js", "default_indexes.js", "default_macros.js", "default_rest.js", "default_elk_saved_searches.js", "default_elk_reference.js", "quotes_db.js", "menu_controller.js", "content.js"],
      "css": ["styles.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/icon.svg"],
      "matches": ["<all_urls>"]
    }
  ]
}
